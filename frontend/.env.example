# --- Auth ---
# Signs the short-lived pending-login cookie. Any random string of 32+ chars:
#   openssl rand -base64 32
# Changing it invalidates in-flight logins (not existing sessions, which live
# in the database).
AUTH_SECRET=

# Encrypts phone numbers at rest, and keys the blind index they are looked up
# by. 32 raw bytes, base64 or hex:
#   openssl rand -base64 32
# Separate from AUTH_SECRET on purpose: rotating that one costs only in-flight
# logins, while rotating this one requires re-encrypting every row (and is not
# implemented — see lib/auth/phone-crypto.ts). Losing it means no stored number
# can be read back or matched again, so every account has to re-verify by SMS.
PHONE_ENCRYPTION_KEY=

# Public origin used to build the OAuth callback URL. Must match the Callback
# URL registered in each provider's console, character for character. Leave
# empty locally (the request origin is used); set it in production, where
# Vercel's proxy can otherwise report the internal deployment URL.
# AUTH_BASE_URL=https://your-domain.example

# --- Naver Login (OAuth) ---
# https://developers.naver.com > Application > 애플리케이션 등록
#   사용 API: 네이버 로그인 / Callback URL: <origin>/api/auth/naver/callback
# NOTE: a different application from the Local Search keys below. Reusing one
# for the other fails with an opaque 401.
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=

# --- SMS verification (Solapi) ---
# https://solapi.com > 개발/연동 > API Key 관리
# Required for ANY sign-in, including local development. Every first login goes
# through SMS verification, and the test-account bypass that used to skip it has
# been removed — without these three the app cannot be signed into at all.
# The verified number is also what links accounts across providers.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 발신번호 — must be pre-registered and approved in the Solapi console
# (1–3 business days). Sends from an unregistered number fail outright.
SOLAPI_SENDER_PHONE=

# --- Database (Supabase Postgres) ---
# Pooled connection (Supavisor, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) — used by prisma migrate only.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- LLM (place extraction) ---
# Any OpenAI-compatible chat-completions endpoint works. The defaults target
# Google Gemini, which has a free tier.
#
# Key: https://aistudio.google.com/apikey -> "Create API key"
# (This is separate from the Gemini CLI's OAuth login — the app needs a key.)
LLM_API_KEY=
# Both optional — omit to use the Gemini defaults shown here.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# --- Naver Local Search (geocoding) ---
# NAVER API HUB (NCP console) > Application Services > NAVER API HUB >
# Application > Application 등록 > 지역 검색 선택 > API 관리 > 인증 정보
# (developers.naver.com's Search API is being retired; new apps blocked since
# 2026-07-31, full shutdown 2027-06-30 — use NAVER API HUB instead.)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- YouTube (optional) ---
# Without a key, YouTube falls back to oEmbed (title + thumbnail only, no description).
YOUTUBE_API_KEY=

# --- Map SDK keys (client-side) ---
# Naver Cloud Platform > Maps > Application (ncpKeyId)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
# Kakao Developers > 앱 키 > JavaScript 키
NEXT_PUBLIC_KAKAO_MAP_KEY=
# Google Cloud > Maps JavaScript API key
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- Vercel Blob (profile pictures, Instagram thumbnails) ---
# Vercel Dashboard > Storage > Create > Blob, then connect the store to this
# project — Vercel injects this token into deployments automatically. For local
# dev copy it here: Storage > (your store) > .env.local tab.
#
# Two consumers, and they fail in opposite ways on purpose:
#
#  - Profile pictures (lib/profile-image.ts): the upload IS the action the user
#    asked for, so a failure surfaces. Without the token the profile page still
#    saves nickname and status message; only the picture fails, as a 400 reading
#    "잠시 후 다시 시도해 주세요" — misleading for a deployment gap, so check the
#    server log for the real cause rather than trusting that wording.
#
#  - Instagram thumbnails (lib/post-thumbnail.ts): a backup the user never
#    asked for, so a failure is silent. Instagram CDN URLs are signed and
#    expire (403 URL signature expired), and ingest copies the bytes here so
#    saved posts keep a thumbnail that still renders months later. Without the
#    token saving a link still succeeds — it just stores Instagram's URL, which
#    will break on its own schedule. Local dev without this token is a normal,
#    working state; only the thumbnails are impermanent.
#
# Rows saved before the store existed are repaired by
# scripts/backfill-thumbnail-backup.ts, which needs this token too.
BLOB_READ_WRITE_TOKEN=

# --- Playwright E2E test account (phone + password login) ---
# A real account created through /verify-phone once, then a password set via
# the phone+password flow. Not read by the app itself — only by Playwright
# test scripts, which log in through the real UI with these values. See
# AGENTS.md for why this must not become a dev-login bypass.
PLAYWRIGHT_TEST_PHONE=
PLAYWRIGHT_TEST_PASSWORD=
