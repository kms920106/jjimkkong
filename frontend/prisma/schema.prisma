// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// engineType = "client" compiles queries in JS and runs them through the
// node-postgres driver adapter (see lib/prisma.ts), so no native engine binary
// is generated. The default "library" engine needs a platform-specific
// libquery_engine .node file, and Next.js does not copy that into the Vercel
// function bundle when the client sits under a custom `output` path — the
// deploy then builds fine and dies at runtime with "could not locate the Query
// Engine for runtime rhel-openssl-3.0.x".
generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  runtime    = "nodejs"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MapProvider {
  NAVER
  KAKAO
  GOOGLE
}

enum Platform {
  INSTAGRAM
  YOUTUBE
  NAVER
  KAKAO
  OTHER
}

/// Which social provider an AuthIdentity came from. Adding a provider is a new
/// value here plus a descriptor in lib/auth/providers/ — no new table, because
/// every provider ends up storing the same three things (their user id, the
/// email they gave us, the phone they gave us).
enum AuthProvider {
  NAVER
  KAKAO
  APPLE
  GOOGLE
}

/// A person. Owns the saved posts and the app-level settings; carries no
/// provider-specific fields, because one person may sign in through several
/// providers (see AuthIdentity).
///
/// `id` is a database-generated sequence, matching every other model here.
/// It was a uuid until 20260825, inherited from the Supabase auth.users id back
/// when Supabase Auth issued sessions — Prisma generated it client-side with
/// `@default(uuid(4))` and there was no database default at all. The migration
/// that replaced Supabase kept the type so the existing rows would still join;
/// this one remaps them and rewrites the three referencing columns
/// (Bookmark.memberId, Session.memberId, AuthIdentity.memberId) in lockstep.
///
/// The value never leaves the server: no DTO carries it, no route accepts it,
/// and nothing validates it as a uuid. That is what made the remap tractable —
/// keep it that way, because an id in a URL is a different decision (see
/// Bookmark.memberSeq for the one place a member-scoped number is exposed).
model Member {
  id              Int         @id @default(autoincrement())
  email           String?
  /// User-chosen display name. Null until they set one; the UI falls back to
  /// the local part of the email so the drawer always has something to show.
  nickname        String?
  /// Free-text line the user writes about themselves, shown under the nickname.
  /// Null when never set; an empty submission clears it back to null rather than
  /// storing "", so the UI has one absent state to check instead of two.
  statusMessage   String?
  /// Absolute URL of the uploaded profile picture on Vercel Blob, or null for
  /// the initial-letter fallback.
  ///
  /// A URL rather than the bytes: the image is served straight off the blob CDN,
  /// so it never travels through this row or through a route handler. The old
  /// blob is deleted when a new one replaces it — nothing else references it,
  /// and Blob storage is billed by what is kept.
  imageUrl        String?
  /// Blind index of the phone number: HMAC-SHA256 of the local-digit form,
  /// `v1:`-prefixed. Set once a provider hands us a verified number or the user
  /// completes the SMS challenge, and it is the key accounts are merged on — a
  /// second provider carrying this same number attaches here instead of
  /// creating a new person.
  ///
  /// Deterministic so it can carry the uniqueness and answer equality lookups;
  /// the recoverable copy is `phoneEnc`. Never compute this by hand — go
  /// through `blindIndex()` in lib/auth/phone-crypto.ts, which only accepts an
  /// already-normalized number.
  ///
  /// Not `@unique`: withdrawal keeps the row, so a number may appear on many
  /// withdrawn rows plus at most one live one. That "at most one live one" is
  /// enforced by a partial unique index (`WHERE "withdrawnAt" IS NULL`) which
  /// Prisma cannot express — see the migration. Every lookup that treats the
  /// number as the merge key must therefore filter on `withdrawnAt: null`
  /// itself; a bare findUnique no longer compiles, which is deliberate.
  phoneHash       String?
  /// AES-256-GCM of the same number, decrypting back to `01012345678`. Never
  /// queried — it has a random IV, so the same number encrypts differently
  /// every time and equality means nothing here.
  ///
  /// Always written and cleared together with `phoneHash`; a CHECK constraint
  /// in the migration enforces that, because a row with one and not the other
  /// is either a number that cannot be recovered or one that cannot be matched.
  phoneEnc        String?
  phoneVerifiedAt DateTime?
  /// scrypt verifier for the password login, `s1.<salt>.<derived>` (base64url).
  /// Null is a normal, common state: an account that signs in through a provider
  /// or through the SMS challenge alone has no password, and never needs one.
  ///
  /// Deliberately on the profile rather than keyed to the phone number. The number
  /// is the merge key, so hanging a credential off it would carry the password
  /// into whatever account the number later merges into — and a recycled mobile
  /// number would hand the previous owner's password to the new one. The person
  /// owns the password, not the number.
  ///
  /// Only ever written after the number has been proven by SMS. Without that
  /// order, anyone could claim a stranger's number by setting a password on it.
  /// Never compared with `===` — see verifyPassword() in lib/auth/password.ts.
  passwordHash    String?
  /// Set when the user withdraws; null for a live account. The row and every
  /// Bookmark under it are kept — withdrawal is a status change, not a delete.
  /// A withdrawn profile is never returned by requireUser(), never matched as a
  /// merge target, and never reattached to a new provider sign-in.
  withdrawnAt     DateTime?
  mapProvider     MapProvider @default(NAVER)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  posts      Bookmark[]
  identities AuthIdentity[]
  sessions   Session[]

  /// Support lookups by number can no longer be typed as a literal — the
  /// column holds an HMAC. Hash the number with `blindIndex()` first and query
  /// that. This index is what keeps such a lookup indexed for withdrawn rows,
  /// which the live-only unique index does not cover.
  @@index([phoneHash])
}

/// One social login attached to a Member. A person with both Naver and
/// Kakao connected has two rows here and one Member.
///
/// The unique is on [provider, providerUserId] rather than providerUserId
/// alone: provider ids are only unique within their own provider, and a bare
/// unique would let a Kakao id collide with a Naver one and hand over the
/// wrong account.
model AuthIdentity {
  id             Int          @id @default(autoincrement())
  memberId       Int
  provider       AuthProvider
  /// The provider's own immutable id for this user. Never the email — users
  /// change those, and matching on them would move the account.
  providerUserId String
  /// What the provider told us at the last sign-in, kept for support/debugging.
  /// Not authoritative: Member holds the values the app actually uses.
  ///
  /// There is deliberately no phone column here any more. It existed for the
  /// same support/debugging reason, but it was written from two different
  /// sources — the provider's raw string on a returning sign-in, the normalized
  /// one on a new link — so the two disagreed on format. Encrypting a field
  /// nobody can read without the key would have kept the inconsistency and
  /// removed the only thing it was good for. Member.phoneEnc is the one
  /// recoverable copy.
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  /// Mirrors Member.withdrawnAt for the rows under a withdrawn account.
  /// Denormalized on purpose: the [provider, providerUserId] uniqueness has to
  /// become "one *live* identity per provider id", and a partial unique index
  /// can only read columns on this table. Written in the same transaction as
  /// the profile, so the two cannot disagree.
  withdrawnAt DateTime?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// Not `@@unique([provider, providerUserId])` any more: a withdrawn identity
  /// keeps its provider id, and a returning user must be able to sign in again
  /// with the same Naver account and get a *new* profile. The live-only
  /// uniqueness is a partial unique index in the migration.
  @@index([provider, providerUserId])
  @@index([memberId])
}

/// A signed-in browser. Sessions live in the database rather than only in a
/// signed cookie so that sign-out and account deletion revoke immediately —
/// a self-contained JWT stays valid until it expires no matter what the server
/// thinks.
///
/// The cookie carries `id`; `tokenHash` is the SHA-256 of a secret half that
/// never touches the database in plaintext, so a leaked table dump cannot be
/// replayed as a live session.
///
/// `id` is NOT a secret and is not opaque — it is a sequential integer, so a
/// caller who holds one valid cookie can name every other session's id by
/// counting. It was a cuid until 20260825, which was already only "guessable
/// enough to matter"; the change makes that certain rather than likely.
///
/// The secret half is therefore the whole of the protection, and every path
/// that acts on a session must verify it: resolveSessionWithUser() compares
/// tokenHash with timingSafeEqual, and destroySession() refuses to delete on a
/// bare id. Do not add a lookup, a revoke, or a debug route that trusts this id
/// alone — with sequential values that is a way to force-log-out any chosen
/// user, and the id's former opacity is no longer even a partial defence.
model Session {
  id        Int      @id @default(autoincrement())
  memberId  Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([expiresAt])
}

/// An in-flight SMS verification. Rows are consumed on success and swept on
/// expiry; `codeHash` is hashed for the same reason Session.tokenHash is.
///
/// `attempts` is the brute-force stop: a 6-digit code is only 10^6 wide, so an
/// unbounded retry budget makes it guessable in minutes.
model PhoneVerification {
  id         Int       @id @default(autoincrement())
  /// Blind index of the number, matching Member.phoneHash. Only ever
  /// compared for equality — the per-number rate limits all count rows for one
  /// number — so the deterministic hash is all this table needs.
  ///
  /// No encrypted copy: nothing reads the number back out of here. The send
  /// path and the verify path each already hold the plaintext, because the user
  /// submitted it in the same request.
  phoneHash  String
  /// Who asked for this code, as an opaque HMAC of the caller's IP. The per-number
  /// limits cannot see one caller walking a list of numbers, and the per-attempt
  /// budget keyed on `purpose` cannot either — a phone-only sign-in mints its own
  /// `purpose`, so discarding the cookie resets it. This is the one key on the row
  /// the caller does not choose.
  ///
  /// Hashed rather than stored raw: an IP is personal data, this table already
  /// holds a blind index of the phone number instead of the number itself, and
  /// nothing needs to read the address back — every query is an equality count.
  /// Null for rows written before the column existed, and for callers whose
  /// address the platform did not supply.
  senderKey  String?
  codeHash   String
  /// Which sign-in this challenge belongs to, so a code minted for one pending
  /// login cannot be redeemed by another. Also the key for the per-login send
  /// budget in sms.ts: the per-number limits cannot see one login fanning out
  /// across many different numbers.
  purpose    String
  attempts   Int       @default(0)
  consumedAt DateTime?
  /// Set when the proof from this row has been spent on a password write.
  ///
  /// `consumedAt` alone is not enough. It marks the code as redeemed, but the
  /// redemption hands back a signed cookie that the password step reads on a
  /// *later* request — so a caller who keeps a copy of that cookie could set a
  /// password repeatedly for the rest of its ten-minute life. The password routes
  /// claim this column in a conditional update, which is what makes one SMS proof
  /// buy exactly one password write.
  spentAt    DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([phoneHash, createdAt])
  /// Backs the per-caller send budget, counted on every send.
  @@index([senderKey, createdAt])
  @@index([expiresAt])
  /// Backs the per-login send budget, which counts rows for one `purpose` on
  /// every send. Without it that count is a sequential scan on the one table
  /// that grows with every login attempt.
  @@index([purpose])
}

/// One password sign-in attempt, for the brute-force budget in
/// lib/auth/password-attempts.ts.
///
/// A table rather than a counter column because the budget is a sliding window over
/// a caller, not a total per account — and it deliberately does not reference
/// Member: attempts for numbers that have no account must be counted too, or
/// an attacker gets a free unlimited probe of which numbers are registered.
///
/// Rows are only ever counted, never read back. `senderKey` is the same HMAC-of-
/// address used by PhoneVerification, so an address is never stored in the clear.
model PasswordAttempt {
  id        Int      @id @default(autoincrement())
  senderKey String
  createdAt DateTime @default(now())

  /// Backs the windowed count, which runs on every password sign-in attempt.
  @@index([senderKey, createdAt])
  /// For sweeping old rows; nothing depends on them after the window passes.
  @@index([createdAt])
}

/// A creator on one platform, as a row rather than a string on every post.
///
/// `author` used to be a handle denormalized onto each saved row, with the
/// avatar copied alongside it — which meant the same person's picture was
/// backed up to a fresh blob for every post of theirs anyone saved, and there
/// was no id to address them by. `/author/1` needs a row.
///
/// Keyed on [platform, handle] because a handle is only unique within its
/// platform, and because that pair is all the ingest pipeline knows: `handle`
/// is what it read off the page. For YouTube it is a channel *title*, free
/// text that may contain spaces and Korean — fine as a value, which is why the
/// URL addresses the id instead.
model Author {
  id          Int      @id @default(autoincrement())
  platform    Platform
  handle      String
  /// The avatar, as a URL renderable as-is — our own Vercel Blob for Instagram,
  /// whose avatar URLs are signed and expire exactly like its post thumbnails.
  /// Null when the platform gave us none.
  image       String?
  /// The pre-backup CDN URL, set only when we copied the avatar — so
  /// `imageSource IS NOT NULL` is the predicate for "this avatar is backed up",
  /// exactly as `thumbnailSource` is on Post.
  imageSource String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[]

  @@unique([platform, handle])
}

/// One creator's post, shared by everyone who saves it.
///
/// Split out of the old SavedPost, which conflated two different things: the
/// post as the platform published it (this) and one member's bookmark of it
/// (Bookmark). The conflation meant every user who pasted the same Instagram
/// link paid for the whole ingest pipeline again — a crawl of a source that
/// blocks us, a model call, and a round of Naver lookups — to arrive at
/// exactly the values another row already held.
///
/// Written once, at the first save of the link, and never updated. That
/// immutability is what makes sharing safe: a row here is read by users who
/// have no relationship to whoever created it, so letting a later save rewrite
/// it would let one user change what another user sees. It also means a
/// re-save costs no crawl at all, which is the point.
///
/// The consequence to keep in mind: a post whose ingest ran while
/// Instagram was blocking us is stuck with what that attempt produced — no
/// thumbnail, no caption — and no user action can fix it, because every later
/// save of that link skips the pipeline and takes this row as it is.
///
/// The escape hatch is `scripts/reingest-post.ts`, which takes explicit ids and
/// is the only writer permitted to modify a row here after creation. A save
/// route must never gain that ability: "a save may rewrite a shared row" is
/// exactly the property this model exists to deny.
///
/// A post with zero matched places is refused at creation rather than stored
/// (POST /api/posts answers 422), because an empty row here is not a bad save
/// but a permanently bad post.
model Post {
  id              Int      @id @default(autoincrement())
  /// The canonical form from canonicalize(), which is what makes two users
  /// pasting the same post with different tracking parameters land on this one
  /// row. A real `@unique` — unlike the old [memberId, sourceUrl], there
  /// is no soft delete here, so there is nothing to scope the uniqueness to.
  sourceUrl       String   @unique
  platform        Platform
  title           String?
  caption         String?  @db.Text
  /// The URL to render. Instagram rows hold a backed-up Vercel Blob URL because
  /// the platform URL they arrive as is a signed URL that expires; every other
  /// platform keeps its own CDN URL here.
  thumbnail       String?
  /// The original CDN URL, set only on rows whose thumbnail was backed up — so
  /// `thumbnailSource IS NOT NULL` is the predicate for "this row is backed up",
  /// which is what the backfill script tests to stay idempotent. Kept even once
  /// expired: it is the only record of where the image came from, and without it
  /// a re-backup would have to re-scrape the post page.
  thumbnailSource String?
  /// Null when the platform named no author, which is the normal state for the
  /// map platforms and for an Instagram post saved while the embed page was
  /// blocked.
  authorId        Int?
  createdAt       DateTime @default(now())

  author Author?     @relation(fields: [authorId], references: [id])
  places PostPlace[]
  saves  Bookmark[]

  @@index([authorId])
  /// Not for reads. Before deleting a thumbnail blob the delete path counts how
  /// many rows still reference that URL, which is what stops one row's cleanup
  /// from taking down an image another row still renders.
  @@index([thumbnail])
}

/// A place this post names, in the order the creator named it.
///
/// `position` is post-level rather than per-save because it is the *creator's*
/// sequence, read off the caption — a date-course post means its stops in
/// order, and that reading is the same for every user who saves it. The write
/// loop sorts by name to keep lock acquisition deterministic across concurrent
/// transactions, so insertion order is not the caption's order.
///
/// Never hard-deleted: Post is immutable, so a row here is never replaced. That
/// is why this model is absent from HARD_DELETE_ALLOWED even though the
/// SavedPostPlace it replaced was on that list — the replacement this table
/// would have needed is exactly the re-save that no longer rewrites anything.
model PostPlace {
  postId   Int
  placeId  Int
  position Int @default(0)

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([postId, placeId])
  @@index([placeId])
}

/// One member's bookmark of one Post.
///
/// Holds only what belongs to that member: which post, when, whether they
/// deleted it, and the memos they wrote. Everything the platform published
/// lives on Post and is shared.
model Bookmark {
  /// The write address for this row: DELETE /api/posts/[id] takes this, not
  /// `memberSeq`. Sequential since 20260825 (a cuid before), so it is now
  /// enumerable — which is exactly why the routes that accept it must keep
  /// scoping by `memberId`. That scoping, not the id's shape, is what stops one
  /// member from naming another's bookmark; see AGENTS.md on ownership checks
  /// living in the application rather than the database.
  id        Int       @id @default(autoincrement())
  memberId  Int
  postId    Int
  /// This bookmark's number within the member's own collection, and what
  /// `/links/1` addresses.
  ///
  /// Per-member rather than a global sequence, which is a privacy property and
  /// not a cosmetic one: a global counter in the URL would publish how many
  /// bookmarks the whole service holds, and would let anyone probe by id
  /// whether a given post exists. Postgres sequences are global, so this is
  /// computed as MAX+1 inside the save transaction with the unique below as
  /// the arbiter of the race.
  memberSeq Int
  /// Set instead of deleting the row, so the memos the member wrote survive a
  /// delete and come back if they bookmark the link again. Every read filters on
  /// this; see the list in AGENTS.md, they all move together.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  member Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  post   Post           @relation(fields: [postId], references: [id])
  memos  BookmarkMemo[]

  /// A real unique, unlike the partial index this replaces. Re-saving a link
  /// the member once deleted now clears `deletedAt` on this row rather than
  /// inserting a second one beside it, which is what restores their memos and
  /// keeps the `/links/<memberSeq>` URL they may have bookmarked working. There
  /// is therefore no live-only scoping to express, and findUnique/upsert on
  /// this key are correct again.
  @@unique([memberId, postId])
  /// Backs the `/links/<memberSeq>` lookup and decides the MAX+1 race above.
  @@unique([memberId, memberSeq])
  @@index([memberId, deletedAt, createdAt])
}

/// What one member wrote about one place on one of their bookmarks.
///
/// Separate from PostPlace because the two have different owners: the place
/// list and its order are the creator's and shared, the note is the member's
/// alone. They were one table back when a post was one member's row.
model BookmarkMemo {
  bookmarkId Int
  placeId    Int
  memo       String?

  bookmark Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  place    Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([bookmarkId, placeId])
  @@index([placeId])
}

/// One real-world place, shared across every post that names it and keyed on
/// [name, address] rather than on anything a client sends.
///
/// `id` reaches the browser — it is in SavedPlaceDTO, it addresses
/// GET /api/places/[id]/sources, and it round-trips through `/?place=<id>,<id>`.
/// Sequential since 20260825 (a cuid before). That exposure is only safe
/// because the row holds nothing private: a place a post already published.
/// Do not hang member-scoped data off this id.
model Place {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  lat       Float
  lng       Float
  category  String?
  naverLink String?
  createdAt DateTime @default(now())

  posts PostPlace[]
  memos BookmarkMemo[]

  @@unique([name, address])
}

/// The pre-split place/memo table, retained and deliberately unread.
///
/// `SavedPostPlace` before the post/bookmark split. Its two halves live on
/// `PostPlace` (the creator's list and order, shared) and `BookmarkMemo` (the
/// member's notes), both populated from these rows by the split migration.
///
/// **Kept because these rows are the one thing a botched split could not
/// reconstruct.** The other pre-split columns were dropped — their values were
/// copied into `Post`, so keeping them would have been a duplicate record. The
/// memos and positions here are not derivable from anything else.
///
/// **Declared because a table the database has and this schema does not is
/// drift**, and `prisma migrate dev` answers drift by offering to reset — which
/// against this repository's live Supabase URL is the irreversible operation
/// CLAUDE.md exists to prevent. A retained table has to be a declared table.
///
/// Nothing reads this model and nothing may write it. It is retired by a later
/// migration that also deletes this block; until then it exists so that
/// `migrate status` stays clean.
model SavedPostPlacePreSplit {
  postId   String
  placeId  String
  position Int     @default(0)
  memo     String?

  @@id([postId, placeId])
  @@index([placeId])
  @@map("_SavedPostPlace_pre_split")
}
