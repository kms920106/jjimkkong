// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// engineType = "client" compiles queries in JS and runs them through the
// node-postgres driver adapter (see lib/prisma.ts), so no native engine binary
// is generated. The default "library" engine needs a platform-specific
// libquery_engine .node file, and Next.js does not copy that into the Vercel
// function bundle when the client sits under a custom `output` path — the
// deploy then builds fine and dies at runtime with "could not locate the Query
// Engine for runtime rhel-openssl-3.0.x".
generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  runtime    = "nodejs"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MapProvider {
  NAVER
  KAKAO
  GOOGLE
}

enum Platform {
  INSTAGRAM
  YOUTUBE
  NAVER
  KAKAO
  OTHER
}

/// Which social provider an AuthIdentity came from. Adding a provider is a new
/// value here plus a descriptor in lib/auth/providers/ — no new table, because
/// every provider ends up storing the same three things (their user id, the
/// email they gave us, the phone they gave us).
enum AuthProvider {
  NAVER
  KAKAO
  APPLE
  GOOGLE
  /// The local test login. Modelled as a provider so requireUser() has exactly
  /// one code path instead of branching on a dev cookie. See lib/dev-auth.ts.
  DEV
}

/// A person. Owns the saved posts and the app-level settings; carries no
/// provider-specific fields, because one person may sign in through several
/// providers (see AuthIdentity).
///
/// `id` stays a uuid generated by us. It used to be the Supabase auth.users id
/// back when Supabase Auth issued sessions; keeping the type means the existing
/// SavedPost.userId rows still join.
model UserProfile {
  id          String      @id @default(uuid(4)) @db.Uuid
  email       String?
  /// User-chosen display name. Null until they set one; the UI falls back to
  /// the local part of the email so the drawer always has something to show.
  nickname    String?
  /// E.164 (+8210…). Set once a provider hands us a verified number or the
  /// user completes the SMS challenge, and it is the key accounts are merged
  /// on — a second provider carrying this same number attaches here instead of
  /// creating a new person.
  phone       String?     @unique
  phoneVerifiedAt DateTime?
  mapProvider MapProvider @default(NAVER)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  posts      SavedPost[]
  identities AuthIdentity[]
  sessions   Session[]
}

/// One social login attached to a UserProfile. A person with both Naver and
/// Kakao connected has two rows here and one UserProfile.
///
/// The unique is on [provider, providerUserId] rather than providerUserId
/// alone: provider ids are only unique within their own provider, and a bare
/// unique would let a Kakao id collide with a Naver one and hand over the
/// wrong account.
model AuthIdentity {
  id             String       @id @default(cuid())
  userId         String       @db.Uuid
  provider       AuthProvider
  /// The provider's own immutable id for this user. Never the email — users
  /// change those, and matching on them would move the account.
  providerUserId String
  /// What the provider told us at the last sign-in, kept for support/debugging.
  /// Not authoritative: UserProfile holds the values the app actually uses.
  email          String?
  phone          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

/// A signed-in browser. Sessions live in the database rather than only in a
/// signed cookie so that sign-out and account deletion revoke immediately —
/// a self-contained JWT stays valid until it expires no matter what the server
/// thinks.
///
/// The cookie carries the opaque `id`; `tokenHash` is the SHA-256 of a secret
/// half that never touches the database in plaintext, so a leaked table dump
/// cannot be replayed as a live session.
model Session {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// An in-flight SMS verification. Rows are consumed on success and swept on
/// expiry; `codeHash` is hashed for the same reason Session.tokenHash is.
///
/// `attempts` is the brute-force stop: a 6-digit code is only 10^6 wide, so an
/// unbounded retry budget makes it guessable in minutes.
model PhoneVerification {
  id         String   @id @default(cuid())
  /// E.164, matching UserProfile.phone.
  phone      String
  codeHash   String
  /// Which sign-in this challenge belongs to, so a code minted for one pending
  /// login cannot be redeemed by another.
  purpose    String
  attempts   Int      @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  sourceUrl String
  platform  Platform
  title     String?
  caption   String?  @db.Text
  thumbnail String?
  author    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  places SavedPostPlace[]

  @@unique([userId, sourceUrl])
  @@index([userId, createdAt])
}

model Place {
  id        String   @id @default(cuid())
  name      String
  address   String
  lat       Float
  lng       Float
  category  String?
  naverLink String?
  createdAt DateTime @default(now())

  posts SavedPostPlace[]

  @@unique([name, address])
}

model SavedPostPlace {
  postId  String
  placeId String
  memo    String?

  post  SavedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  place Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([postId, placeId])
  @@index([placeId])
}
