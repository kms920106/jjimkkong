// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// engineType = "client" compiles queries in JS and runs them through the
// node-postgres driver adapter (see lib/prisma.ts), so no native engine binary
// is generated. The default "library" engine needs a platform-specific
// libquery_engine .node file, and Next.js does not copy that into the Vercel
// function bundle when the client sits under a custom `output` path — the
// deploy then builds fine and dies at runtime with "could not locate the Query
// Engine for runtime rhel-openssl-3.0.x".
generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  runtime    = "nodejs"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MapProvider {
  NAVER
  KAKAO
  GOOGLE
}

enum Platform {
  INSTAGRAM
  YOUTUBE
  NAVER
  KAKAO
  OTHER
}

/// Mirrors a row in Supabase's auth.users. Created lazily on the first
/// authenticated request; Prisma cannot manage the auth schema itself.
model UserProfile {
  id          String      @id @db.Uuid
  email       String?
  /// User-chosen display name. Null until they set one; the UI falls back to
  /// the local part of the email so the drawer always has something to show.
  nickname    String?
  mapProvider MapProvider @default(NAVER)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  posts SavedPost[]
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  sourceUrl String
  platform  Platform
  title     String?
  caption   String?  @db.Text
  thumbnail String?
  author    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  places SavedPostPlace[]

  @@unique([userId, sourceUrl])
  @@index([userId, createdAt])
}

model Place {
  id        String   @id @default(cuid())
  name      String
  address   String
  lat       Float
  lng       Float
  category  String?
  naverLink String?
  createdAt DateTime @default(now())

  posts SavedPostPlace[]

  @@unique([name, address])
}

model SavedPostPlace {
  postId  String
  placeId String
  memo    String?

  post  SavedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  place Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([postId, placeId])
  @@index([placeId])
}
